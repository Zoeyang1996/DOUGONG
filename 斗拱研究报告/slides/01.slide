<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '60px', flexDirection: 'row', position: 'relative' }}>

    {/* 左侧标题区 */}
    <Box style={{ width: 620, flexDirection: 'column', justifyContent: 'flex-end', paddingBottom: 96 }}>

        <Box style={{ width: 56, height: 4, background: '#1E4FA8', marginBottom: 36 }} />

        <Text style={{ fontSize: 20, color: '#1E4FA8', letterSpacing: 3, fontWeight: '600', marginBottom: 18 }}>
            古建筑木构专题研究
        </Text>

        <Text style={{ fontSize: 62, fontWeight: 'bold', color: '#1A2230', lineHeight: 1.18, letterSpacing: 1 }}>
            斗拱:形制、受力
            <br />
            与千年演变
        </Text>

        <Text style={{ fontSize: 22, color: '#4A5568', lineHeight: 1.6, marginTop: 26, width: 540 }}>
            以宁波保国寺北宋大殿(1013 年)为中心,
            <br />
            拆解一朵木构件的构造逻辑与制度变迁
        </Text>

        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, marginTop: 54 }}>
            <Box style={{ width: 3, height: 40, background: '#D6DCE5' }} />
            <Box style={{ flexDirection: 'column', gap: 5 }}>
                <Text style={{ fontSize: 15, color: '#4A5568' }}>浙江工商职业技术学院 · 数字媒体技术</Text>
                <Text style={{ fontSize: 15, color: '#8B97A8' }}>2026 年 11 月</Text>
            </Box>
        </Box>
    </Box>

    {/* 右侧斗拱剪影 */}
    <Box style={{ width: 480, flexDirection: 'column', justifyContent: 'center', alignItems: 'center' }}>
        <svg width={440} height={520} viewBox='0 0 440 520'>
            {/* 背景竖线网格——测绘图纸感 */}
            <line x1='220' y1='40' x2='220' y2='500' stroke='#E8EFF8' strokeWidth='1' strokeDasharray='4 6' />
            <line x1='60' y1='272' x2='380' y2='272' stroke='#E8EFF8' strokeWidth='1' strokeDasharray='4 6' />

            {/* 柱 */}
            <rect x='204' y='404' width='32' height='96' fill='#9C7A5B' />

            {/* 栌斗(口大底小) */}
            <path d='M196 404 L244 404 L252 368 L188 368 Z' fill='#8B6446' />
            <rect x='188' y='362' width='64' height='8' fill='#C9A882' />

            {/* 第一跳华栱 */}
            <rect x='150' y='340' width='140' height='22' fill='#C9A882' />
            <rect x='186' y='330' width='68' height='10' fill='#9C7A5B' />

            {/* 第二跳 */}
            <rect x='126' y='308' width='188' height='22' fill='#C9A882' />
            <rect x='204' y='298' width='32' height='10' fill='#9C7A5B' />

            {/* 第三跳 */}
            <rect x='100' y='276' width='240' height='22' fill='#C9A882' />
            <rect x='186' y='266' width='68' height='10' fill='#9C7A5B' />

            {/* 第四跳(令栱层) */}
            <rect x='74' y='244' width='292' height='22' fill='#C9A882' />

            {/* 下昂:斜置构件,长身压在跳头 */}
            <path d='M366 236 L96 300' stroke='#8B6446' strokeWidth='13' strokeLinecap='butt' />
            <path d='M366 236 L96 300' stroke='#5E4330' strokeWidth='1.5' strokeLinecap='butt' opacity='0.4' />

            {/* 檐口 / 槫 */}
            <rect x='52' y='212' width='336' height='26' fill='#1E4FA8' opacity='0.9' />
            <rect x='52' y='238' width='336' height='6' fill='#1E4FA8' opacity='0.35' />

            {/* 屋顶轮廓 */}
            <path d='M52 212 L20 176 L420 176 L388 212 Z' fill='#E8EFF8' />
            <path d='M20 176 L420 176' stroke='#1E4FA8' strokeWidth='2' />

            {/* 红色标注点:昂尾 */}
            <circle cx='366' cy='236' r='6' fill='#D9534F' />
            <line x1='392' y1='236' x2='424' y2='236' stroke='#D9534F' strokeWidth='1' />
            <text x='392' y='228' fontSize='13' fill='#D9534F' fontFamily='Arial'>ang</text>
        </svg>
    </Box>

</Slide>
