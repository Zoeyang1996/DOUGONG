<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '60px', flexDirection: 'column', position: 'relative' }}>

    <Box style={{ width: 1160, height: 56, background: '#1E4FA8', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 24, paddingRight: 24 }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#FFFFFF' }}>数一朵斗拱:七铺作双杪双下昂单偷心造</Text>
        <Text style={{ fontSize: 16, color: '#C9DAF3', letterSpacing: 1 }}>04 · 实例分析</Text>
    </Box>

    <Box style={{ width: 1160, height: 520, marginTop: 24, flexDirection: 'row' }}>

        {/* 左:出跳图 */}
        <Box style={{ width: 580, flexDirection: 'column' }}>
            <svg width={560} height={450} viewBox='0 0 560 430'>
                {/* 柱 */}
                <rect x='56' y='210' width='36' height='190' fill='#9C7A5B' />
                <text x='74' y='420' fontSize='12' fill='#8B97A8' textAnchor='middle' fontFamily='Arial'>column</text>

                {/* 栌斗 */}
                <path d='M44 210 L104 210 L112 178 L36 178 Z' fill='#8B6446' />

                {/* 第1跳 华栱 */}
                <rect x='60' y='154' width='240' height='24' fill='#C9A882' />
                <circle cx='300' cy='166' r='13' fill='#1E4FA8' />
                <text x='300' y='171' fontSize='13' fill='#FFFFFF' textAnchor='middle' fontFamily='Arial'>1</text>

                {/* 第2跳 华栱 */}
                <rect x='92' y='126' width='268' height='24' fill='#C9A882' />
                <circle cx='360' cy='138' r='13' fill='#1E4FA8' />
                <text x='360' y='143' fontSize='13' fill='#FFFFFF' textAnchor='middle' fontFamily='Arial'>2</text>

                {/* 第3跳 下昂 */}
                <path d='M124 100 L440 142' stroke='#8B6446' strokeWidth='20' strokeLinecap='butt' />
                <circle cx='424' cy='140' r='13' fill='#D9534F' />
                <text x='424' y='145' fontSize='13' fill='#FFFFFF' textAnchor='middle' fontFamily='Arial'>3</text>

                {/* 第4跳 下昂 */}
                <path d='M156 74 L484 116' stroke='#8B6446' strokeWidth='20' strokeLinecap='butt' />
                <circle cx='468' cy='114' r='13' fill='#D9534F' />
                <text x='468' y='119' fontSize='13' fill='#FFFFFF' textAnchor='middle' fontFamily='Arial'>4</text>

                {/* 檐口 */}
                <rect x='484' y='40' width='12' height='120' fill='#1E4FA8' opacity='0.85' />
                <text x='512' y='60' fontSize='12' fill='#8B97A8' fontFamily='Arial'>eave</text>

                {/* 偷心提示:第1跳跳头空 */}
                <path d='M300 178 L300 196' stroke='#D9534F' strokeWidth='2' strokeDasharray='4 4' />
                <text x='306' y='200' fontSize='12' fill='#D9534F' fontFamily='Arial'>no cross-arm</text>

                <text x='36' y='30' fontSize='12' fill='#1E4FA8' fontFamily='Arial'>4 projections (tiao) · 2 huagong + 2 xia'ang</text>
            </svg>
            <Text style={{ fontSize: 15, color: '#8B97A8' }}>
                出跳示意:蓝圈为华栱跳,红圈为下昂跳
            </Text>
        </Box>

        {/* 右:公式与结论 */}
        <Box style={{ width: 580, flexDirection: 'column', paddingLeft: 40 }}>

            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1A2230' }}>铺作数的算法</Text>

            <Box style={{ height: 96, background: '#1E4FA8', marginTop: 16, flexDirection: 'row', alignItems: 'center', justifyContent: 'center' }}>
                <Text style={{ fontSize: 20, color: '#C9DAF3' }}>铺作数 =</Text>
                <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#FFFFFF', marginLeft: 12 }}>n</Text>
                <Text style={{ fontSize: 20, color: '#C9DAF3', marginLeft: 12 }}>+ 3</Text>
            </Box>

            <Box style={{ flexDirection: 'row', marginTop: 14 }}>
                <Text style={{ fontSize: 17, color: '#4A5568', flex: 1, lineHeight: 1.6 }}>
                    n 为出跳数(华栱或昂的层数),3 为栌斗层、耍头层、衬枋头层三个固定层。
                </Text>
            </Box>

            <Box style={{ flexDirection: 'row', marginTop: 16, alignItems: 'flex-end' }}>
                <Text style={{ fontSize: 17, color: '#4A5568', width: 120 }}>本朵 n =</Text>
                <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#1E4FA8' }}>4</Text>
                <Text style={{ fontSize: 17, color: '#4A5568', marginLeft: 24 }}>4 + 3 =</Text>
                <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#D9534F', marginLeft: 10 }}>7</Text>
                <Text style={{ fontSize: 17, color: '#4A5568', marginLeft: 8 }}>铺作</Text>
            </Box>

            <Box style={{ width: 500, height: 1, background: '#E5E7EB', marginTop: 22, marginBottom: 20 }} />

            <Box style={{ flexDirection: 'column', gap: 8 }}>
                <Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.55 }}>
                    <span style={{ fontWeight: 'bold', color: '#1A2230' }}>双杪</span>:两跳华栱(跳 1、2)
                </Text>
                <Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.55 }}>
                    <span style={{ fontWeight: 'bold', color: '#1A2230' }}>双下昂</span>:两跳下昂(跳 3、4)
                </Text>
                <Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.55 }}>
                    <span style={{ fontWeight: 'bold', color: '#1A2230' }}>单偷心</span>:第一跳跳头不放横栱
                </Text>
            </Box>

            <Box style={{ height: 56, background: '#E8EFF8', marginTop: 12, flexDirection: 'row', alignItems: 'center', paddingLeft: 16, paddingRight: 16 }}>
                <Text style={{ fontSize: 16, color: '#1A2230', lineHeight: 1.45 }}>
                    七铺作属宋代高等级做法,是最高的第三等(最高为八铺作)。
                </Text>
            </Box>

        </Box>

    </Box>

    <Box style={{ position: 'absolute', left: 60, right: 60, top: 672, flexDirection: 'row', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>斗拱:形制、受力与千年演变</Text>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>17 / 20</Text>
    </Box>

</Slide>
