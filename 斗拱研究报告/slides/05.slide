<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '60px', flexDirection: 'column', position: 'relative' }}>

    <Box style={{ width: 1160, height: 56, background: '#1E4FA8', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 24, paddingRight: 24 }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#FFFFFF' }}>研究对象:一座 1013 年的南方木构</Text>
        <Text style={{ fontSize: 16, color: '#C9DAF3', letterSpacing: 1 }}>01 · 研究背景</Text>
    </Box>

    <Box style={{ width: 1160, height: 520, marginTop: 24, flexDirection: 'row' }}>

        {/* 左:四项档案 */}
        <Box style={{ width: 620, flexDirection: 'column', justifyContent: 'space-between' }}>

            <Box style={{ flexDirection: 'row' }}>
                <Box style={{ width: 148, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 15, color: '#8B97A8', letterSpacing: 1 }}>建造年代</Text>
                    <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#1E4FA8', marginTop: 8 }}>1013</Text>
                </Box>
                <Box style={{ flex: 1, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 20, fontWeight: '600', color: '#1A2230' }}>北宋大中祥符六年</Text>
                    <Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.6, marginTop: 6 }}>
                        长江以南现存最古老、保存最完整的木构建筑之一。1954 年由刘敦桢团队发现。
                    </Text>
                </Box>
            </Box>

            <Box style={{ width: 620, height: 1, background: '#E5E7EB' }} />

            <Box style={{ flexDirection: 'row' }}>
                <Box style={{ width: 148, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 15, color: '#8B97A8', letterSpacing: 1 }}>平面尺度</Text>
                    <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#1E4FA8', marginTop: 8 }}>3×3</Text>
                </Box>
                <Box style={{ flex: 1, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 20, fontWeight: '600', color: '#1A2230' }}>面阔三间,进深三间</Text>
                    <Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.6, marginTop: 6 }}>
                        面阔 11.91 m、进深 13.36 m——<span style={{ color: '#D9534F', fontWeight: 'bold' }}>进深大于面阔</span>,是判断宋构的重要线索。
                    </Text>
                </Box>
            </Box>

            <Box style={{ width: 620, height: 1, background: '#E5E7EB' }} />

            <Box style={{ flexDirection: 'row' }}>
                <Box style={{ width: 148, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 15, color: '#8B97A8', letterSpacing: 1 }}>斗拱规模</Text>
                    <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#1E4FA8', marginTop: 8 }}>20 种</Text>
                </Box>
                <Box style={{ flex: 1, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 20, fontWeight: '600', color: '#1A2230' }}>外檐 7 种,全部下昂造</Text>
                    <Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.6, marginTop: 6 }}>
                        外檐斗拱外跳均为七铺作双杪双下昂,下一杪偷心;内檐 7 种,天花装修 3 种。
                    </Text>
                </Box>
            </Box>

            <Box style={{ width: 620, height: 1, background: '#E5E7EB' }} />

            <Box style={{ flexDirection: 'row' }}>
                <Box style={{ width: 148, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 15, color: '#8B97A8', letterSpacing: 1 }}>构件精度</Text>
                    <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#1E4FA8', marginTop: 8 }}>1504</Text>
                </Box>
                <Box style={{ flex: 1, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 20, fontWeight: '600', color: '#1A2230' }}>个斗、673 根栱</Text>
                    <Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.6, marginTop: 6 }}>
                        东南大学 2009—2012 年测绘,近 3000 个构件逐一手测至毫米级。可支撑零件级建模。
                    </Text>
                </Box>
            </Box>

        </Box>

        {/* 右:平面柱网 */}
        <Box style={{ width: 540, flexDirection: 'column', alignItems: 'center', paddingLeft: 40 }}>
            <svg width={420} height={430} viewBox='0 0 300 380'>
                {/* 柱网轴线 */}
                <line x1='50' y1='60' x2='252' y2='60' stroke='#D6DCE5' strokeWidth='1' strokeDasharray='5 5' />
                <line x1='50' y1='135' x2='252' y2='135' stroke='#D6DCE5' strokeWidth='1' strokeDasharray='5 5' />
                <line x1='50' y1='211' x2='252' y2='211' stroke='#D6DCE5' strokeWidth='1' strokeDasharray='5 5' />
                <line x1='50' y1='287' x2='252' y2='287' stroke='#D6DCE5' strokeWidth='1' strokeDasharray='5 5' />

                <line x1='50' y1='60' x2='50' y2='287' stroke='#D6DCE5' strokeWidth='1' strokeDasharray='5 5' />
                <line x1='149' y1='60' x2='149' y2='287' stroke='#D6DCE5' strokeWidth='1' strokeDasharray='5 5' />
                <line x1='201' y1='60' x2='201' y2='287' stroke='#D6DCE5' strokeWidth='1' strokeDasharray='5 5' />
                <line x1='252' y1='60' x2='252' y2='287' stroke='#D6DCE5' strokeWidth='1' strokeDasharray='5 5' />

                {/* 屋面轮廓 */}
                <rect x='50' y='60' width='202' height='227' fill='none' stroke='#1E4FA8' strokeWidth='2' />

                {/* 16 根柱 */}
                <circle cx='50' cy='60' r='7' fill='#1E4FA8' />
                <circle cx='149' cy='60' r='7' fill='#1E4FA8' />
                <circle cx='201' cy='60' r='7' fill='#1E4FA8' />
                <circle cx='252' cy='60' r='7' fill='#1E4FA8' />

                <circle cx='50' cy='135' r='7' fill='#1E4FA8' />
                <circle cx='149' cy='135' r='7' fill='#1E4FA8' />
                <circle cx='201' cy='135' r='7' fill='#1E4FA8' />
                <circle cx='252' cy='135' r='7' fill='#1E4FA8' />

                <circle cx='50' cy='211' r='7' fill='#1E4FA8' />
                <circle cx='149' cy='211' r='7' fill='#1E4FA8' />
                <circle cx='201' cy='211' r='7' fill='#1E4FA8' />
                <circle cx='252' cy='211' r='7' fill='#1E4FA8' />

                <circle cx='50' cy='287' r='7' fill='#1E4FA8' />
                <circle cx='149' cy='287' r='7' fill='#1E4FA8' />
                <circle cx='201' cy='287' r='7' fill='#1E4FA8' />
                <circle cx='252' cy='287' r='7' fill='#1E4FA8' />

                {/* 敞廊区 */}
                <rect x='50' y='60' width='202' height='75' fill='#E8EFF8' opacity='0.7' />

                {/* 尺寸标注 */}
                <line x1='50' y1='40' x2='252' y2='40' stroke='#8B97A8' strokeWidth='1' />
                <line x1='50' y1='35' x2='50' y2='45' stroke='#8B97A8' strokeWidth='1' />
                <line x1='252' y1='35' x2='252' y2='45' stroke='#8B97A8' strokeWidth='1' />

                <line x1='278' y1='60' x2='278' y2='287' stroke='#D9534F' strokeWidth='1' />
                <line x1='273' y1='60' x2='283' y2='60' stroke='#D9534F' strokeWidth='1' />
                <line x1='273' y1='287' x2='283' y2='287' stroke='#D9534F' strokeWidth='1' />

                <text x='151' y='30' fontSize='15' fill='#4A5568' textAnchor='middle' fontFamily='Arial'>11.91 m</text>
                <text x='254' y='100' fontSize='15' fill='#D9534F' fontFamily='Arial'>13.36</text>
                <text x='254' y='118' fontSize='15' fill='#D9534F' fontFamily='Arial'>m</text>

                <text x='100' y='104' fontSize='13' fill='#1E4FA8' textAnchor='middle' fontFamily='Arial'>open porch</text>

                <text x='50' y='318' fontSize='13' fill='#8B97A8' fontFamily='Arial'>column grid · 16 columns</text>
                <text x='50' y='340' fontSize='13' fill='#8B97A8' fontFamily='Arial'>crotched columns (gualeng)</text>
            </svg>
            <Text style={{ fontSize: 15, color: '#8B97A8', marginTop: 4 }}>
                据东南大学测绘数据重绘,仅示意柱网与开间关系
            </Text>
        </Box>

    </Box>

    <Box style={{ position: 'absolute', left: 60, right: 60, top: 672, flexDirection: 'row', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>斗拱:形制、受力与千年演变</Text>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>05 / 20</Text>
    </Box>

</Slide>
