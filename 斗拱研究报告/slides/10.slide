<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '60px', flexDirection: 'column', position: 'relative' }}>

    <Box style={{ width: 1160, height: 56, background: '#1E4FA8', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 24, paddingRight: 24 }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#FFFFFF' }}>力是怎么走下来的:四段传递</Text>
        <Text style={{ fontSize: 16, color: '#C9DAF3', letterSpacing: 1 }}>02 · 受力原理</Text>
    </Box>

    <Box style={{ width: 1160, height: 520, marginTop: 24, flexDirection: 'row' }}>

        {/* 左:力流图 */}
        <Box style={{ width: 460, flexDirection: 'column' }}>
            <svg width={440} height={440} viewBox='0 0 380 380'>
                {/* 屋面荷载:多条细线 */}
                <line x1='90' y1='30' x2='90' y2='86' stroke='#3D7BD9' strokeWidth='2' />
                <line x1='130' y1='30' x2='122' y2='86' stroke='#3D7BD9' strokeWidth='2' />
                <line x1='170' y1='30' x2='154' y2='86' stroke='#3D7BD9' strokeWidth='2' />
                <line x1='210' y1='30' x2='206' y2='86' stroke='#3D7BD9' strokeWidth='2' />
                <line x1='250' y1='30' x2='250' y2='86' stroke='#3D7BD9' strokeWidth='2' />
                <line x1='290' y1='30' x2='290' y2='86' stroke='#3D7BD9' strokeWidth='2' />

                {/* 屋面线 */}
                <line x1='60' y1='30' x2='320' y2='30' stroke='#1E4FA8' strokeWidth='4' />

                {/* 斗拱层:梯形,示意收敛后展开 */}
                <path d='M128 86 L252 86 L268 118 L112 118 Z' fill='#C9A882' />
                <path d='M112 118 L268 118 L272 136 L108 136 Z' fill='#9C7A5B' />

                {/* 从斗拱到柱的传力 */}
                <line x1='190' y1='136' x2='190' y2='176' stroke='#D9534F' strokeWidth='5' />
                <line x1='190' y1='176' x2='190' y2='176' stroke='#D9534F' strokeWidth='5' />

                {/* 柱 */}
                <rect x='170' y='176' width='40' height='140' fill='#9C7A5B' />

                {/* 柱础与台基 */}
                <rect x='152' y='316' width='76' height='14' fill='#8B97A8' />
                <rect x='80' y='330' width='220' height='18' fill='#D6DCE5' />

                {/* 基础散力 */}
                <line x1='190' y1='348' x2='190' y2='366' stroke='#1E4FA8' strokeWidth='3' />
                <line x1='120' y1='366' x2='260' y2='366' stroke='#1E4FA8' strokeWidth='3' />
                <line x1='120' y1='366' x2='104' y2='376' stroke='#1E4FA8' strokeWidth='2' />
                <line x1='260' y1='366' x2='276' y2='376' stroke='#1E4FA8' strokeWidth='2' />

                {/* 编号 */}
                <circle cx='340' cy='58' r='13' fill='#1E4FA8' />
                <text x='340' y='63' fontSize='14' fill='#FFFFFF' textAnchor='middle' fontFamily='Arial'>1</text>

                <circle cx='340' cy='112' r='13' fill='#1E4FA8' />
                <text x='340' y='117' fontSize='14' fill='#FFFFFF' textAnchor='middle' fontFamily='Arial'>2</text>

                <circle cx='340' cy='200' r='13' fill='#1E4FA8' />
                <text x='340' y='205' fontSize='14' fill='#FFFFFF' textAnchor='middle' fontFamily='Arial'>3</text>

                <circle cx='340' cy='340' r='13' fill='#1E4FA8' />
                <text x='340' y='345' fontSize='14' fill='#FFFFFF' textAnchor='middle' fontFamily='Arial'>4</text>

                <text x='60' y='22' fontSize='12' fill='#8B97A8' fontFamily='Arial'>roof load</text>
            </svg>
            <Text style={{ fontSize: 15, color: '#8B97A8' }}>
                荷载路径示意:均布 → 集中 → 换向 → 入地
            </Text>
        </Box>

        {/* 右:四段说明 */}
        <Box style={{ width: 700, flexDirection: 'column', paddingLeft: 40, justifyContent: 'space-between' }}>

            <Box style={{ flexDirection: 'row' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E4FA8', width: 32 }}>1</Text>
                <Box style={{ flex: 1 }}>
                    <Text style={{ fontSize: 20, fontWeight: '600', color: '#1A2230' }}>屋面 → 槫:均布变集中</Text>
                    <Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.6, marginTop: 6 }}>
                        瓦作与屋架的均布荷载经椽传到槫(檩),在槫上形成一道道集中力。槫再把这些力交给斗拱。
                    </Text>
                </Box>
            </Box>

            <Box style={{ flexDirection: 'row' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E4FA8', width: 32 }}>2</Text>
                <Box style={{ flex: 1 }}>
                    <Text style={{ fontSize: 20, fontWeight: '600', color: '#1A2230' }}>槫 → 斗拱:逐层分解</Text>
                    <Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.6, marginTop: 6 }}>
                        槫落在栌斗与交互斗上,再由华栱、昂把力分成若干份。每一跳的跳头都是一个新的承力点。
                    </Text>
                </Box>
            </Box>

            <Box style={{ flexDirection: 'row' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E4FA8', width: 32 }}>3</Text>
                <Box style={{ flex: 1 }}>
                    <Text style={{ fontSize: 20, fontWeight: '600', color: '#1A2230' }}>斗拱 → 柱:力的方向被折了四次</Text>
                    <Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.6, marginTop: 6 }}>
                        出挑使力从竖直转为水平,昂尾再把水平力收回柱身。斗拱因此不是"堆叠",而是一套换向机构。
                    </Text>
                </Box>
            </Box>

            <Box style={{ flexDirection: 'row' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E4FA8', width: 32 }}>4</Text>
                <Box style={{ flex: 1 }}>
                    <Text style={{ fontSize: 20, fontWeight: '600', color: '#1A2230' }}>柱 → 基础:受压入地</Text>
                    <Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.6, marginTop: 6 }}>
                        柱身以受压为主,经柱础把荷载扩散到台基。整条路径上,木材始终工作在顺纹受压的有利状态。
                    </Text>
                </Box>
            </Box>

            <Box style={{ height: 76, background: '#E8EFF8', flexDirection: 'row', alignItems: 'center', paddingLeft: 18, paddingRight: 18, marginTop: 8 }}>
                <Text style={{ fontSize: 18, color: '#1A2230', lineHeight: 1.5 }}>
                    一句话:<span style={{ color: '#D9534F', fontWeight: 'bold' }}>斗拱的本质是"力的换向机构"</span>——把竖直荷载换成水平出挑,再收回柱身。
                </Text>
            </Box>

        </Box>

    </Box>

    <Box style={{ position: 'absolute', left: 60, right: 60, top: 672, flexDirection: 'row', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>斗拱:形制、受力与千年演变</Text>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>10 / 20</Text>
    </Box>

</Slide>
